# Vorlage. Echte Werte nur in .env.local (lokal) bzw. in Vercel → Settings → Environment Variables.
# Supabase Dashboard → Project Settings → API Keys / Data API

# Projekt-URL, z. B. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# „Publishable key“ (sb_publishable_…), darf im Browser landen
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# „Secret key“ (sb_secret_…), nur auf dem Server: Konto einrichten, Startdaten, Import
SUPABASE_SECRET_KEY=
